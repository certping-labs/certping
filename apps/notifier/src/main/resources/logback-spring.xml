<configuration>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] [${APP_NAME}] %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- Suppress Azure SDK internal logs below WARN -->
    <logger name="com.azure" level="WARN" />
    <logger name="com.microsoft.azure" level="WARN" />
    <logger name="reactor.netty" level="WARN" />
    <logger name="org.apache.qpid" level="WARN" />
    <logger name="io.netty" level="WARN" />

    <root level="DEBUG">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>
