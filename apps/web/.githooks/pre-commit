# Formats the staged files under src with Prettier and stages the result. Only files that are part
# of this commit are touched, so other work in progress stays out of the commit.

set -eu

files="$(git diff --cached --name-only --diff-filter=ACMR --relative -- src)"
if [ -z "$files" ]; then
  exit 0
fi

echo "Formatting staged files with Prettier..."
# Paths in this repository contain no newlines; brackets and parentheses are fine.
echo "$files" | tr '\n' '\0' | xargs -0 pnpm exec prettier --write --ignore-unknown --log-level warn \
  || { echo "Failed: Prettier. Run 'pnpm install' in apps/web first." >&2; exit 1; }
echo "$files" | tr '\n' '\0' | xargs -0 git add --

echo "Pre-commit formatting passed."
