ARG NODE_BUILD_IMAGE=node:24.22.3-bookworm-slim@sha256:873f586f3794f52281bd039bf02c048a0be08fde619338f9941bad1eb6b34530

FROM ${NODE_BUILD_IMAGE} AS base
WORKDIR /app

# Install dependencies only when needed.
FROM base AS deps
COPY package.json pnpm-workspace.yaml yarn.lock* package-lock.json* pnpm-lock.yaml* .npmrc* ./
RUN set -eux; \
    if [ -f yarn.lock ]; then yarn install --frozen-lockfile; \
    elif [ -f package-lock.json ]; then npm ci; \
    elif [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm install --frozen-lockfile; \
    else echo "Lockfile not found." >&2; exit 1; \
    fi

# Rebuild the source code only when needed.
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Where the browser calls the API. Next.js inlines NEXT_PUBLIC_* values at build time, so this
# is the one setting that cannot change after the build. The default, same-origin, makes the
# browser call /api/* on the page's own origin; Caddy (all-in-one, Compose) and the Helm Ingress
# route /api/* to the server, so one released image serves every domain and every kit without a
# build argument. On the Next.js server, same-origin resolves to CERTPING_URL, read from the
# runtime environment (see src/lib/api-base-url.ts). A custom build for an API on another origin
# passes an absolute http(s) URL, or a path such as /api-proxy for the development proxy.
ARG NEXT_PUBLIC_API_URL=same-origin
# Optional build identifier, usually the release version. Next.js accepts only letters, digits,
# hyphens and underscores, so the build step below turns 0.1.0-rc.1 into 0-1-0-rc-1. It is baked
# into the build output, so the runtime stage does not set it.
ARG NEXT_DEPLOYMENT_ID
ARG NEXT_PUBLIC_NAMECHEAP_OUTBOUND_IP
ENV NEXT_PUBLIC_API_URL="${NEXT_PUBLIC_API_URL}"
ENV NEXT_PUBLIC_APP_MODE="enterprise"
ENV NEXT_PUBLIC_NAMECHEAP_OUTBOUND_IP="${NEXT_PUBLIC_NAMECHEAP_OUTBOUND_IP}"
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS=--max-old-space-size=4096

RUN test "$NEXT_PUBLIC_APP_MODE" = "enterprise"
# The API address contract: same-origin, an absolute http(s) URL, or an absolute path. An empty
# value would leave the status banner with no address to read, so it is refused here.
RUN case "$NEXT_PUBLIC_API_URL" in \
      same-origin|http://?*|https://?*|/?*) echo "NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL" ;; \
      *) echo "NEXT_PUBLIC_API_URL must be same-origin, an http(s) URL or a path starting with / (got '$NEXT_PUBLIC_API_URL')" >&2; exit 1 ;; \
    esac

RUN set -eux; \
    deployment_id="$(printf '%s' "${NEXT_DEPLOYMENT_ID:-}" | tr -c 'A-Za-z0-9_-' '-')"; \
    if [ -n "$deployment_id" ]; then \
      export NEXT_DEPLOYMENT_ID="$deployment_id" NEXT_PUBLIC_DEPLOYMENT_ID="$deployment_id"; \
    else \
      unset NEXT_DEPLOYMENT_ID; \
    fi; \
    if [ -f yarn.lock ]; then yarn run build; \
    elif [ -f package-lock.json ]; then npm run build; \
    elif [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm run build; \
    else echo "Lockfile not found." >&2; exit 1; \
    fi

# Hardened runtime (UBI):
# - Uses Red Hat UBI Node.js 24 image that is redistributable for enterprise delivery.
# - Pin to scanned digest for reproducibility/compliance traceability.
FROM registry.access.redhat.com/ubi10/nodejs-24@sha256:228c8675a62feb55f88dc9dee94d5a82e6f0e887ec47bd8f5e524a797a0984d7 AS runner
WORKDIR /app

# Remove SSH client tooling from the runtime image to reduce attack surface.
USER 0
RUN set -eux; \
    dnf remove -y --setopt=protected_packages= openssh-clients dnf yum; \
    rm -rf /var/cache/dnf /var/lib/dnf /etc/yum.repos.d/*

# Informational in the runtime stage: the build above already inlined these into the bundles.
# The API address on the Next.js server comes from CERTPING_URL, set by each kit at runtime.
ARG NEXT_PUBLIC_API_URL=same-origin
ARG NEXT_PUBLIC_NAMECHEAP_OUTBOUND_IP
ENV NEXT_PUBLIC_API_URL="${NEXT_PUBLIC_API_URL}"
ENV NEXT_PUBLIC_APP_MODE="enterprise"
ENV NEXT_PUBLIC_NAMECHEAP_OUTBOUND_IP="${NEXT_PUBLIC_NAMECHEAP_OUTBOUND_IP}"
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# next/image runs sharp (libvips) on the libuv threads. With glibc's default
# per-thread arenas and sliding mmap threshold, the memory each encode frees
# stays resident, so RSS climbs with every optimised image until the pod is
# OOMKilled. Two arenas and fixed mmap/trim thresholds hand it back to the OS.
ENV MALLOC_ARENA_MAX=2
ENV MALLOC_MMAP_THRESHOLD_=131072
ENV MALLOC_TRIM_THRESHOLD_=131072
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# CertPing's LICENSE and NOTICE and the third-party notices for this image, generated by
# .github/scripts/third-party-notices.sh into licenses/ of this build context. They go in a subfolder of
# /licenses so that any terms the base image keeps there stay as they are.
COPY --chown=0:0 licenses/ /licenses/certping/

# Image metadata. The UBI base sets name, vendor, summary, description and url to its own image:
# override them so the image describes CertPing. Its created and revision labels describe the
# base image build, so they are cleared; the release workflow sets revision and version.
LABEL org.opencontainers.image.created="" \
      org.opencontainers.image.revision="" \
      org.opencontainers.image.title="certping-web" \
      org.opencontainers.image.description="CertPing web app (Next.js)" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/certping-labs/certping" \
      org.opencontainers.image.url="https://github.com/certping-labs/certping" \
      org.opencontainers.image.documentation="https://github.com/certping-labs/certping" \
      org.opencontainers.image.vendor="Seaionl Inc." \
      name="certping-web" \
      vendor="Seaionl Inc." \
      maintainer="Seaionl Inc." \
      summary="CertPing web app (Next.js)" \
      description="CertPing web app (Next.js)" \
      url="https://github.com/certping-labs/certping" \
      usage="https://github.com/certping-labs/certping" \
      io.k8s.display-name="certping-web" \
      io.k8s.description="CertPing web app (Next.js)"

COPY --from=builder --chown=1001:0 /app/public ./public
COPY --from=builder --chown=1001:0 /app/.next/standalone ./
COPY --from=builder --chown=1001:0 /app/.next/static ./.next/static

USER 1001
EXPOSE 3000

# Override UBI's default s2i entrypoint for direct Next.js standalone startup.
ENTRYPOINT ["node"]
CMD ["server.js"]
