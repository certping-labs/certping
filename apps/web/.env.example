# Build-time environment variables for a local development build.
# NEXT_PUBLIC_* values are baked into the Next.js build and cannot be changed at runtime.

# Where the browser calls the API. Use "same-origin" when a reverse proxy routes
# /api to the server on the web app's origin, or "/api-proxy" together with
# CERTPING_API_TARGET below to proxy through the Next.js server.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional, read by next.config.ts: the API origin that /api-proxy/* forwards to.
# The proxy route exists only when this is set; there is no default target.
# CERTPING_API_TARGET=http://localhost:8080

# Which sign-in pages are enabled. "enterprise" enables `/login/enterprise` and `/auth/sso/*`
# (the web Dockerfile builds with this value). Empty or anything else enables the local auth
# pages (`/login`, `/forgot-password` and so on).
NEXT_PUBLIC_APP_MODE=

# Optional. The agent's public IP, shown in the Namecheap credential form so users know which
# address to allowlist in the Namecheap API settings.
NEXT_PUBLIC_NAMECHEAP_OUTBOUND_IP=
