# ── Stage 1: Build ────────────────────────────────────────────────────────────
# The build stage runs on the builder's own architecture: the jar is bytecode, so a
# multi-platform build compiles once natively instead of once per target under QEMU.
FROM --platform=$BUILDPLATFORM maven:3.9-eclipse-temurin-26@sha256:b2c1ad85954592f9928e84327c65201f308ad9b5d8ed7d5b823717c97bf23fbb AS build
WORKDIR /app

# Cache dependency layer separately (only re-downloads on pom.xml change)
COPY pom.xml lombok.config ./
RUN mvn dependency:go-offline -q

COPY src ./src
RUN mvn clean package -DskipTests -q

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
# Same hardened runtime as the server and notifier: Red Hat UBI 9 OpenJDK 25, pinned by digest,
# running as uid 185 with the package manager removed.
FROM registry.access.redhat.com/ubi9/openjdk-25-runtime@sha256:1db3895f42eecbabea53523a25da537901b7ce599c404e179c5e6e4cdf1cedef AS runtime
WORKDIR /app

USER 0

# OpenTelemetry Java agent, pinned to a release and verified against its published sha256
# (the GitHub release asset digest and the Maven Central .sha256 agree). Bump both together.
ARG OTEL_JAVAAGENT_VERSION=2.32.0
ARG OTEL_JAVAAGENT_SHA256=f787eb6c7f3d18e69a431e108a15278d25ee37f83d68b678f621e063f3988f82
RUN mkdir -p /app/otel && \
  curl -fsSL -o /app/otel/opentelemetry-javaagent.jar \
    "https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_JAVAAGENT_VERSION}/opentelemetry-javaagent.jar" && \
  echo "${OTEL_JAVAAGENT_SHA256}  /app/otel/opentelemetry-javaagent.jar" | sha256sum -c - && \
  chmod 0444 /app/otel/opentelemetry-javaagent.jar

# No package manager in the final image (curl stays for the health check, as in the server).
RUN set -eux; \
    microdnf remove -y microdnf; \
    rm -rf /var/cache/dnf /var/cache/yum

# CertPing's LICENSE and NOTICE and the third-party notices for this image, generated by
# .github/scripts/third-party-notices.sh into licenses/ of this build context. They go in a subfolder of
# /licenses so that any terms the base image keeps there stay as they are.
COPY --chown=0:0 licenses/ /licenses/certping/

# Image metadata. The UBI base sets name, vendor, summary, description and url to its own image:
# override them so the image describes CertPing. Its created and revision labels describe the
# base image build, so they are cleared; the release workflow sets revision and version.
LABEL org.opencontainers.image.created="" \
      org.opencontainers.image.revision="" \
      org.opencontainers.image.title="certping-agent" \
      org.opencontainers.image.description="CertPing agent: issues and deploys certificates in its network and keeps the private keys there" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/certping-labs/certping" \
      org.opencontainers.image.url="https://github.com/certping-labs/certping" \
      org.opencontainers.image.documentation="https://github.com/certping-labs/certping" \
      org.opencontainers.image.vendor="Seaionl Inc." \
      name="certping-agent" \
      vendor="Seaionl Inc." \
      maintainer="Seaionl Inc." \
      summary="CertPing agent: issues and deploys certificates in its network and keeps the private keys there" \
      description="CertPing agent: issues and deploys certificates in its network and keeps the private keys there" \
      url="https://github.com/certping-labs/certping" \
      usage="https://github.com/certping-labs/certping" \
      io.k8s.display-name="certping-agent" \
      io.k8s.description="CertPing agent: issues and deploys certificates in its network and keeps the private keys there"

# The jar belongs to root and is read only for the runtime user.
COPY --from=build /app/target/certping-agent-*.jar /app/app.jar
RUN chmod 0444 /app/app.jar

USER 185
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:${SERVER_PORT:-8080}/actuator/health/readiness || exit 1

# The self-hosted settings unless the run says otherwise.
ENV SPRING_PROFILES_ACTIVE=selfhosted
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom"
ENV OTEL_JAVAAGENT_PATH="/app/otel/opentelemetry-javaagent.jar" \
    OTEL_JAVAAGENT_ENABLED="false"

ENTRYPOINT ["/bin/sh", "-c", "exec java -javaagent:${OTEL_JAVAAGENT_PATH} ${JAVA_OPTS} -jar app.jar"]
